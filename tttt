    // ===== COMPUTE STATS =====
    function computeStats(data) {
        const total = data.length;
        const civil = data.filter(r => (r['Tipo de Serviço'] || '').toUpperCase() === 'CIVIL').length;
        
        const eletrica = data.filter(r => {
            const type = (r['Tipo de Serviço'] || '').toUpperCase();
            return type.includes('ELETRICA') || type.includes('ELÉTRICA');
        }).length;

        let totalConformes = 0, totalInconformes = 0, totalNA = 0;
        let valorTotalSum = 0;
        const fieldStats = {};

        complianceFields.forEach(field => {
            fieldStats[field] = { sim: 0, nao: 0, na: 0 };
        });

        data.forEach(row => {
            valorTotalSum += parseCurrency(row['Valor Total']);

            complianceFields.forEach(field => {
                const rawVal = row[field];
                const val = (rawVal || '').trim().toUpperCase().replace(/\./g, '');
                if (val === 'SIM' || val === 'CORRIGIDO') { 
                    fieldStats[field].sim++; 
                    totalConformes++;
                }
                else if (val === 'NÃO' || val === 'NAO') { 
                    fieldStats[field].nao++; 
                    totalInconformes++;
                }
                else if (val === 'NA') { 
                    fieldStats[field].na++; 
                    totalConformes++; // NA / N.A conta como CONFORME (SIM)
                    totalNA++;
                }
            });
        });

        const totalSim = totalConformes;
        const totalNao = totalInconformes;
        const applicable = totalSim + totalNao;
        const complianceRate = applicable > 0 ? ((totalSim / applicable) * 100) : 0;

        return { total, civil, eletrica, totalSim, totalNao, totalNA, complianceRate, fieldStats, valorTotalSum };
    }

    // ===== ANIMATE NUMBER =====
    function animateNumber(el, target, suffix = '', duration = 800) {
        if (!el) return;
        const start = 0;
        const startTime = performance.now();
        const isFloat = target % 1 !== 0;

        function update(now) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = start + (target - start) * eased;
            el.textContent = (isFloat ? current.toFixed(1) : Math.round(current)) + suffix;
            if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
    }

    function animateCurrency(el, target, duration = 800) {
        if (!el) return;
        const start = 0;
        const startTime = performance.now();

        function update(now) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = start + (target - start) * eased;
            el.textContent = formatCurrency(current);
            if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
    }

