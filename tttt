            return (row['Número da medição'] || '').toLowerCase().includes(searchTerm) ||
                   (row['Coordenação'] || '').toLowerCase().includes(searchTerm) ||
                   (row['Tipo de Serviço'] || '').toLowerCase().includes(searchTerm) ||
                   (row['OBS'] || '').toLowerCase().includes(searchTerm) ||
