                if (upperVal === 'NÃO' || upperVal === 'NAO') return '<span class="badge badge-nao">NÃO</span>';
                if (upperVal === 'CORRIGIDO') return '<span class="badge" style="background: rgba(0, 79, 159, 0.12); color: #004F9F;">CORRIGIDO</span>';
                return '<span class="badge badge-na">NA</span>';
            };
            
            let cellsHTML = '';
            headers.forEach(header => {
                const val = row[header];
                if (complianceFields.includes(header)) {
                    cellsHTML += `<td>${badge(val)}</td>`;
                } else if (header === 'Tipo de Serviço') {
                    const typeVal = (val || '').toUpperCase();
                    const typeBadge = (typeVal.includes('ELETRICA') || typeVal.includes('ELÉTRICA'))
                        ? '<span class="badge badge-eletrica">ELÉTRICA</span>'
                        : '<span class="badge badge-civil">CIVIL</span>';
                    cellsHTML += `<td>${typeBadge}</td>`;
                } else if (header === 'Valor Total') {
                    const parsedVal = parseCurrency(val);
                    const valorDisplay = (parsedVal === 0) 
                        ? '<span style="color: var(--text-muted);">—</span>' 
                        : `<span style="font-weight: 600; color: var(--accent-emerald);">${formatCurrency(parsedVal)}</span>`;
                    cellsHTML += `<td>${valorDisplay}</td>`;
                } else if (header === 'Coordenação') {
                    const coordVal = val || '—';
                    const coordDisplay = coordVal === '#N/D' ? '<span style="color: var(--text-muted);">Não Definida</span>' : coordVal.replace('Coordenação ', '');
                    cellsHTML += `<td>${coordDisplay}</td>`;
                } else if (header === 'Data de Análise') {
                    const dateVal = val || '—';
                    cellsHTML += `<td><span class="badge badge-na" style="background: rgba(0, 86, 145, 0.1); color: var(--accent-indigo);">${dateVal}</span></td>`;
                } else if (header === 'OBS') {
                    const obs = val || '—';
                    cellsHTML += `<td title="${obs}" style="text-align: left;">${obs}</td>`;
                } else if (header === 'Número da medição') {
                    cellsHTML += `<td style="font-weight:600; color: var(--text-primary);">${val || '—'}</td>`;
                } else {
                    cellsHTML += `<td>${val || '—'}</td>`;
                }
            });
            tr.innerHTML = cellsHTML;
            tbody.appendChild(tr);
        });
        currentFilteredData = filtered;
    }

    // ===== CONTROLE DE MEDIÇÕES CORRIGIDAS (100% CONFORMES) =====
    function isCorrected(row) {
        // Retorna true se houver a palavra "CORRIGIDO" em qualquer coluna da linha
        return Object.keys(row).some(key => {
            const rawVal = row[key];
            if (!rawVal) return false;
            const val = String(rawVal).trim().toUpperCase().replace(/\./g, '');
            return val === 'CORRIGIDO';
        });
    }

