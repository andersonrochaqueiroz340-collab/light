    // ===== DATA LOADER =====
    async function loadData() {
        try {
            let response = await fetch('base_análise.csv');
            if (!response.ok) {
                response = await fetch('base_an%C3%A1lise.csv');
            }
            if (!response.ok) throw new Error('Falha no carregamento do arquivo.');
            
            const arrayBuffer = await response.arrayBuffer();
            processCSVBuffer(arrayBuffer);
        } catch (error) {
            console.warn('Carregamento automático bloqueado ou arquivo ausente (CORS):', error);
            showUploadUI();
        }
    }

    function processCSVBuffer(arrayBuffer) {
        let decoder = new TextDecoder('utf-8');
        let text = decoder.decode(arrayBuffer);
        
        // Se a decodificação UTF-8 contiver caracteres inválidos de substituição (como \ufffd), tenta Windows-1252
        if (text.includes('\ufffd')) {
            decoder = new TextDecoder('windows-1252');
            text = decoder.decode(arrayBuffer);
        }
        
        processCSVText(text);
    }

    function processCSVText(text) {
        const { headers: parsedHeaders, data: parsedData } = parseCSV(text);
        const cleanData = parsedData.filter(row => row['Número da medição'] || row['Parceira']);
        
        if (cleanData.length === 0) {
            alert('Aviso: Não foi possível ler registros válidos da planilha. Verifique se:\n\n1. O arquivo carregado é a planilha de medições correta.\n2. Se existem as colunas principais como "Parceira" ou "Número da medição".');
            showUploadUI();
            return;
        }
        
        hideUploadUI();
        initDashboard(parsedHeaders, cleanData);
    }

    function handleFileUpload(event) {
        const file = event.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
            const arrayBuffer = e.target.result;
            processCSVBuffer(arrayBuffer);
        };
        reader.readAsArrayBuffer(file);
    }

