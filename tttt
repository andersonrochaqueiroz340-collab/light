    // ===== EXPORT TABLE TO CSV/EXCEL =====
    function exportTableToCSV(type) {
        const dataToExport = type === 'corrected' ? currentFilteredCorrectedData : currentFilteredData;
        if (!dataToExport || dataToExport.length === 0) {
            alert('Não há registros para baixar.');
            return;
        }

        let csvContent = '\uFEFF'; // Adiciona UTF-8 BOM para o Excel abrir com acentos corretos
        
        // Cabeçalho do CSV
        csvContent += headers.join(';') + '\n';
        
        // Linhas de dados
        dataToExport.forEach(row => {
            const line = headers.map(header => {
                let val = row[header] === undefined || row[header] === null ? '' : String(row[header]);
                if (val.includes(';')) {
                    val = `"${val.replace(/"/g, '""')}"`;
                }
                return val;
            }).join(';');
            csvContent += line + '\n';
        });

        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const filename = type === 'corrected' ? 'base_medicoes_corrigidas_filtrada.csv' : 'base_medicoes_filtrada.csv';
        
        if (navigator.msSaveBlob) { // IE 10+
            navigator.msSaveBlob(blob, filename);
        } else {
            link.href = URL.createObjectURL(blob);
            link.setAttribute('download', filename);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    }

    // ===== EXPORT STATIC PANEL =====
    function exportStaticHTML() {
        if (allData.length === 0) {
            alert('Nenhum dado carregado para exportar.');
            return;
        }

        // Reconstrói a string CSV a partir dos dados em memória
        let csvContent = headers.join(';') + '\n';
        allData.forEach(row => {
            const line = headers.map(h => {
                let val = row[h] || '';
                if (val.includes(';')) {
                    val = `"${val}"`;
                }
                return val;
            }).join(';');
            csvContent += line + '\n';
        });

        // Pega o HTML completo da página
        const htmlContent = document.documentElement.outerHTML;

        // Injeta os dados na variável csvRaw do script
        const targetString = 'const csvRaw = `/*CSV_DATA_PLACEHOLDER*/`;';
        const replacementString = 'const csvRaw = `' + csvContent.replace(/`/g, '\\`').replace(/\$/g, '\\$') + '`;';
        
        let finalHtml = htmlContent.replace(targetString, replacementString);

        // Prepara o nome do arquivo com mês e ano
        const dateObj = new Date();
        const months = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
        const fileName = `Painel_Medicoes_${months[dateObj.getMonth()]}_${dateObj.getFullYear()}.html`;

        const blob = new Blob([finalHtml], { type: 'text/html;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    // ===== SEARCH INPUT EVENT =====
    document.getElementById('searchInput').addEventListener('input', () => {
        updateTable(getFilteredData());
    });

    document.getElementById('correctedSearchInput').addEventListener('input', () => {
        const filteredData = getFilteredData();
        const correctedData = filteredData.filter(isCorrected);
        updateCorrectedTable(correctedData);
    });

    // ===== RUN =====
    const isCompiled = csvRaw.trim() && !csvRaw.includes('/*CSV_DATA_PLACEHOLDER*/');
    if (isCompiled) {
        processCSVText(csvRaw);
    } else {
        loadData();
    }
