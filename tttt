            'obs': 'OBS',
            'observacao': 'OBS',
            'observacoes': 'OBS',
            'datadeanalise': 'Data de Análise',
            'data': 'Data de Análise'
        };

        return rawHeaders.map(h => {
            const normalized = normalizeHeader(h);
            if (headerMapping[normalized]) {
                return headerMapping[normalized];
            }
            if (normalized.includes('apr') && normalized.includes('pet')) return '(APR) e (PET)';
            if (normalized.includes('gestor') && normalized.includes('assin')) return 'Assinatura do Gestor Responsável';
            if (normalized.includes('fotos')) {
                if (normalized.includes('qualidade')) return 'Qualidade das fotos';
                return 'Fotos do início e do fim da atividade';
            }
            if (normalized.includes('compreens')) return 'Facilidade de compreensão';
            if (normalized.includes('croqui')) return 'Croqui da Atividade';
            if (normalized.includes('diario')) return 'Diário de Obra';
            if (normalized === 'valortotal') return 'Valor Total';
            if (normalized.includes('valortotaldamedicao') || normalized.includes('valormedicao')) return 'Valor Total da medição (R$)';
            
            // Detecção estrita da coluna de Data de Análise (tolerante a erros de acentuação/codificação)
            if (normalized.includes('data') && 
                (normalized.includes('analis') || 
                 normalized.includes('anlis') || 
                 normalized.includes('anise') || 
                 normalized.includes('analiz') || 
                 normalized.includes('anliz'))) {
                return 'Data de Análise';
            }
            
            return h.trim();
        });
    }

    // ===== PARSE CSV =====
    function parseCSV(raw) {
        const lines = raw.split(/\r?\n/).filter(l => l.trim());
        if (lines.length === 0) return { headers: [], data: [] };
        
        // Detecta delimitador dinamicamente na primeira linha
        let delimiter = ';';
        const firstLine = lines[0];
        const semicolons = (firstLine.match(/;/g) || []).length;
        const commas = (firstLine.match(/,/g) || []).length;
        const tabs = (firstLine.match(/\t/g) || []).length;
        
        if (tabs > semicolons && tabs > commas) {
            delimiter = '\t';
        } else if (commas > semicolons) {
            delimiter = ',';
        }
        
        function splitCSVLine(line) {
            const result = [];
            let current = '';
            let inQuotes = false;
            for (let i = 0; i < line.length; i++) {
                const char = line[i];
                if (char === '"') {
                    inQuotes = !inQuotes;
                } else if (char === delimiter && !inQuotes) {
                    result.push(current.trim());
                    current = '';
                } else {
                    current += char;
                }
            }
            result.push(current.trim());
            return result;
        }

        const rawHeaders = splitCSVLine(lines[0]);
        const headers = mapHeaders(rawHeaders);
        const data = [];
        for (let i = 1; i < lines.length; i++) {
            const cols = splitCSVLine(lines[i]);
            const row = {};
            headers.forEach((h, idx) => {
                let val = cols[idx] || '';
                if (val.startsWith('"') && val.endsWith('"')) {
                    val = val.substring(1, val.length - 1);
                }
                row[h] = val.trim();
            });
            data.push(row);
        }
        return { headers, data };
    }

    // Helper functions for currency
    function parseCurrency(val) {
        if (!val || val.includes('#N/D')) return 0;
        const clean = val.replace('R$', '').replace(/\s/g, '').replace(/\./g, '').replace(',', '.');
        const parsed = parseFloat(clean);
        return isNaN(parsed) ? 0 : parsed;
    }

    function formatCurrency(num) {
        return num.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }



