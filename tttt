    // ===== MATRIX DE CONFORMIDADE =====
    function updateMatrix(stats) {
        const grid = document.getElementById('matrixGrid');
        grid.innerHTML = '';
        complianceFields.forEach(field => {
            const fs = stats.fieldStats[field];
            if (!fs) return;
            const applicable = fs.sim + fs.nao + fs.na;
            if (applicable === 0) return;
            const pct = applicable > 0 ? ((fs.sim + fs.na) / applicable) * 100 : 100;
            const level = pct >= 90 ? 'high' : pct >= 50 ? 'medium' : 'low';
            
            const item = document.createElement('div');
            item.className = 'matrix-item';
            item.innerHTML = `
                <div class="matrix-item-label">${fieldShortNames[field] || field}</div>
                <div class="matrix-bar-container">
                    <div class="matrix-bar ${level}" style="width: 0%"></div>
                </div>
                <div class="matrix-stats">
                    <span class="matrix-percentage ${level}">${pct.toFixed(0)}%</span>
                    <span class="matrix-count">${fs.sim} SIM · ${fs.nao} NÃO${fs.na > 0 ? ' · ' + fs.na + ' NA' : ''}</span>
                </div>
            `;
            grid.appendChild(item);

            // Animação da barra
            requestAnimationFrame(() => {
                setTimeout(() => {
                    const bar = item.querySelector('.matrix-bar');
                    if (bar) bar.style.width = pct + '%';
                }, 100);
            });
        });
    }

