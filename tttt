<html lang="pt-BR"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Painel de Análise de Conformidade de Medições - ELCOP / LIGHT">
    <title>Painel de Conformidade — Medições</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <style>
        /* ===== RESET & BASE ===== */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-primary: #edf4f5; /* Fundo base gelo com toque verde-petróleo LIGHT */
            --bg-secondary: rgba(255, 255, 255, 0.45); 
            --bg-card: rgba(255, 255, 255, 0.8); /* Vidro branco translúcido */
            --bg-card-hover: rgba(255, 255, 255, 0.92);
            --bg-glass: rgba(255, 255, 255, 0.85);
            --border: rgba(0, 114, 114, 0.07); /* Borda verde-petróleo sutil */
            --border-glow: rgba(0, 114, 114, 0.22); /* Brilho verde-petróleo corporativo */
            --text-primary: #0f294a; /* Azul marinho profundo corporativo */
            --text-secondary: #334e68; /* Azul cinza escuro */
            --text-muted: #627d98; /* Azul cinza médio */
            --accent-indigo: #007272; /* Nova cor institucional Light S.A. */
            --accent-violet: #00a4a4; /* Verde-petróleo claro */
            --accent-emerald: #10b981; /* Verde esmeralda conformidade */
            --accent-amber: #f59e0b; /* Laranja valor total */
            --accent-rose: #ef4444; /* Vermelho alertas */
            --accent-cyan: #06b6d4;
            --accent-blue: #3b82f6;
            --gradient-primary: linear-gradient(135deg, #007272 0%, #00a4a4 100%); /* Gradiente institucional Light */
            --gradient-success: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --gradient-warning: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            --gradient-danger: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            --gradient-info: linear-gradient(135deg, #00a4a4 0%, #007272 100%);
            --shadow-card: 0 10px 30px -5px rgba(0, 114, 114, 0.03);
            --shadow-glow: 0 12px 35px -5px rgba(0, 114, 114, 0.07);
            --radius: 16px;
            --radius-sm: 10px;
            --transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: -20%;
            left: -10%;
            width: 60%;
            height: 60%;
            background: radial-gradient(circle, rgba(0, 114, 114, 0.12) 0%, rgba(0, 114, 114, 0.02) 60%, transparent 100%);
            z-index: 0;
            pointer-events: none;
            filter: blur(100px);
            animation: float1 25s infinite alternate ease-in-out;
        }

        body::after {
            content: '';
            position: fixed;
            bottom: -20%;
            right: -10%;
            width: 70%;
            height: 70%;
            background: radial-gradient(circle, rgba(64, 199, 221, 0.07) 0%, rgba(0, 114, 114, 0.02) 60%, transparent 100%);
            z-index: 0;
            pointer-events: none;
            filter: blur(120px);
            animation: float2 30s infinite alternate ease-in-out;
        }

        @keyframes float1 {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(10%, 15%) scale(1.2); }
        }

        @keyframes float2 {
            0% { transform: translate(0, 0) scale(1.2); }
            100% { transform: translate(-15%, -10%) scale(0.9); }
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(0, 79, 159, 0.2); border-radius: 3px; }

        /* ===== LAYOUT ===== */
        .dashboard {
            position: relative;
            z-index: 1;
            max-width: 1440px;
            margin: 0 auto;
            padding: 24px 32px 48px;
        }

        /* ===== HEADER ===== */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            padding: 16px 24px;
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 4px 16px rgba(0, 79, 159, 0.2);
        }

        .header h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #007272;
            letter-spacing: -0.5px;
        }

        .header-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .header-content-bottom {
            display: flex;
            gap: 16px;
            width: 100%;
            justify-content: space-between;
            align-items: stretch;
            flex-wrap: wrap;
        }
        .header-summary-box {
            flex: 1;
            min-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            justify-content: center;
        }
        .header-filters-box {
            flex: 1.2;
            min-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            justify-content: center;
            align-items: flex-end;
        }
        .vertical-divider {
            width: 1px;
            background: rgba(0, 79, 159, 0.08);
        }

        /* ===== TICKER SCROLLER ===== */
        .ticker-wrapper {
            width: 100%;
            overflow: hidden;
            background: rgba(0, 79, 159, 0.03);
            border-top: 1px solid rgba(0, 79, 159, 0.06);
            border-bottom: 1px solid rgba(0, 79, 159, 0.06);
            padding: 6px 0;
            border-radius: 6px;
            display: flex;
            align-items: center;
        }

        .ticker-content {
            display: inline-flex;
            white-space: nowrap;
            gap: 40px;
            align-items: center;
            font-size: 0.78rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .ticker-separator {
            color: rgba(0, 79, 159, 0.2);
            font-weight: 800;
        }

        .ticker-status {
            display: flex;
            align-items: center;
            color: var(--accent-emerald);
            font-weight: 600;
        }

        .animate-ticker {
            animation: ticker-roll 30s linear infinite;
        }

        @keyframes ticker-roll {
            0% {
                transform: translate3d(0, 0, 0);
            }
            100% {
                transform: translate3d(-33.333%, 0, 0);
            }
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .filter-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-btn {
            padding: 10px 20px;
            border-radius: var(--radius-sm);
            border: 1px solid rgba(0, 79, 159, 0.1);
            background: rgba(255, 255, 255, 0.7);
            color: var(--text-secondary);
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-btn:hover {
            border-color: rgba(0, 79, 159, 0.3);
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.95);
        }

        .filter-btn.active {
            background: var(--gradient-primary);
            border-color: transparent;
            color: #fff;
            box-shadow: 0 4px 16px rgba(0, 79, 159, 0.15);
        }

        .filter-select {
            padding: 10px 16px;
            border-radius: var(--radius-sm);
            border: 1px solid rgba(0, 79, 159, 0.1);
            background: rgba(255, 255, 255, 0.7);
            color: var(--text-secondary);
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            outline: none;
        }

        .filter-select:hover {
            border-color: rgba(0, 79, 159, 0.3);
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.95);
        }

        .filter-select option {
            background: #ffffff;
            color: var(--text-primary);
        }

        /* ===== UPLOAD ZONE ===== */
        .upload-zone {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 28px;
            padding: 32px;
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            border: 2px dashed var(--border-glow);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
            text-align: center;
        }

        .upload-card {
            max-width: 500px;
        }

        .upload-icon {
            font-size: 3rem;
            margin-bottom: 16px;
            animation: bounce 2s infinite;
        }

        .upload-zone h3 {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .upload-zone p {
            font-size: 0.88rem;
            color: var(--text-secondary);
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .upload-btn {
            display: inline-block;
            padding: 12px 28px;
            background: var(--gradient-primary);
            color: white;
            font-weight: 600;
            font-size: 0.88rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 16px rgba(0, 79, 159, 0.2);
        }

        .upload-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 79, 159, 0.3);
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        /* ===== KPI CARDS ===== */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
            position: relative;
            overflow: hidden;
            transition: var(--transition);
            cursor: default;
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
            box-shadow: var(--shadow-glow);
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .kpi-card:nth-child(1)::before { background: var(--gradient-primary); }
        .kpi-card:nth-child(2)::before { background: var(--gradient-warning); }
        .kpi-card:nth-child(3)::before { background: var(--gradient-success); }
        .kpi-card:nth-child(4)::before { background: var(--gradient-danger); }

        .kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 16px;
        }

        .kpi-card:nth-child(1) .kpi-icon { background: rgba(0, 114, 114, 0.08); color: #007272; }
        .kpi-card:nth-child(2) .kpi-icon { background: rgba(245, 158, 11, 0.08); color: #fbbf24; }
        .kpi-card:nth-child(3) .kpi-icon { background: rgba(16, 185, 129, 0.08); color: #10b981; }
        .kpi-card:nth-child(4) .kpi-icon { background: rgba(239, 68, 68, 0.08); color: #ef4444; }

        .kpi-label {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 8px;
        }

        .kpi-value {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1;
        }

        .kpi-card:nth-child(1) .kpi-value { color: var(--accent-indigo); }
        .kpi-card:nth-child(2) .kpi-value { color: var(--accent-amber); }
        .kpi-card:nth-child(3) .kpi-value { color: var(--accent-emerald); }
        .kpi-card:nth-child(4) .kpi-value { color: var(--accent-rose); }

        .kpi-sub {
            font-size: 0.78rem;
            color: var(--text-secondary);
            margin-top: 8px;
        }

        /* ===== CHARTS GRID ===== */
        .charts-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .chart-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            transition: var(--transition);
            height: 420px; /* Altura ideal padronizada para os gráficos */
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .chart-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
            box-shadow: var(--shadow-glow);
        }

        .chart-title {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 4px;
            color: var(--text-primary);
        }

        .chart-subtitle {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .chart-container {
            position: relative;
            width: 100%;
            height: 300px; /* Altura fixa ideal do gráfico interno */
        }

        /* ===== SECOND CHARTS ROW ===== */
        .charts-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        /* ===== COMPLIANCE MATRIX ===== */
        .matrix-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            margin-bottom: 28px;
            height: auto; /* Exibe todos os campos sem limite de altura */
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .matrix-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 12px;
            margin-top: 20px;
        }

        .matrix-item {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 16px;
            transition: var(--transition);
            cursor: default;
        }

        .matrix-item:hover {
            border-color: var(--border-glow);
            transform: translateY(-2px);
        }

        .matrix-item-label {
            font-size: 0.72rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: 10px;
            line-height: 1.3;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            min-height: 32px;
        }

        .matrix-bar-container {
            height: 8px;
            background: rgba(0, 79, 159, 0.06);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 8px;
        }

        .matrix-bar {
            height: 100%;
            border-radius: 4px;
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            width: 0;
        }

        .matrix-bar.high { background: var(--gradient-success); }
        .matrix-bar.medium { background: var(--gradient-warning); }
        .matrix-bar.low { background: var(--gradient-danger); }

        .matrix-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .matrix-percentage {
            font-size: 1.1rem;
            font-weight: 700;
        }

        .matrix-percentage.high { color: var(--accent-emerald); }
        .matrix-percentage.medium { color: var(--accent-amber); }
        .matrix-percentage.low { color: var(--accent-rose); }

        .matrix-count {
            font-size: 0.72rem;
            color: var(--text-muted);
        }

        /* ===== OBSERVATIONS SECTION ===== */
        .obs-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            margin-bottom: 28px;
            max-height: 420px;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }


        /* ===== DATA TABLE ===== */
        .table-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            overflow: hidden;
            box-shadow: var(--shadow-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .search-input {
            padding: 10px 16px;
            border-radius: var(--radius-sm);
            border: 1px solid rgba(0, 79, 159, 0.1);
            background: rgba(255, 255, 255, 0.7);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            width: 280px;
            transition: var(--transition);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--border-glow);
            box-shadow: 0 0 0 3px rgba(0, 79, 159, 0.15);
        }

        .search-input::placeholder {
            color: var(--text-muted);
        }

        .table-wrapper {
            overflow-x: auto;
            border-radius: var(--radius-sm);
            border: 1px solid rgba(0, 79, 159, 0.05);
            max-height: 410px;
            overflow-y: auto;
        }

        .chart-scroll-wrapper {
            overflow-y: auto;
            overflow-x: hidden;
            height: 280px;
            width: 100%;
            position: relative;
            scrollbar-width: thin;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8rem;
        }

        thead th {
            background: #007272;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 12px;
            text-align: center;
            white-space: nowrap;
            border-bottom: 2px solid #005555;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        tbody tr {
            transition: var(--transition);
            border-bottom: 1px solid rgba(0, 79, 159, 0.06);
        }

        tbody tr:last-child { border-bottom: none; }

        tbody tr:hover {
            background: rgba(0, 79, 159, 0.03);
        }

        tbody td {
            padding: 12px 16px;
            white-space: nowrap;
            color: var(--text-secondary);
            text-align: center;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 3px 10px;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-sim {
            background: rgba(16, 185, 129, 0.12);
            color: #047857;
        }

        .badge-nao {
            background: rgba(239, 68, 68, 0.12);
            color: #b91c1c;
        }

        .badge-na {
            background: rgba(0, 79, 159, 0.06);
            color: var(--text-muted);
        }

        .badge-civil {
            background: rgba(64, 199, 221, 0.12);
            color: #40C7DD;
        }

        .badge-eletrica {
            background: rgba(26, 138, 138, 0.12);
            color: #1A8A8A;
        }

        .rejections-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
            align-items: stretch;
        }

        .rejections-row .chart-card {
            height: 380px !important;
            max-height: 380px !important;
        }

        .rejections-row .table-wrapper {
            height: 275px !important;
            max-height: 275px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }

        .rejections-row .chart-scroll-wrapper {
            height: 275px !important;
            max-height: 275px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }

        #obsTableBody td {
            white-space: normal !important;
            word-break: break-word;
        }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-in {
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            opacity: 0;
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }
        .delay-5 { animation-delay: 0.5s; }
        .delay-6 { animation-delay: 0.6s; }
        .delay-7 { animation-delay: 0.7s; }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1200px) {
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
            .charts-grid { grid-template-columns: 1fr; }
            .charts-grid-2 { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            .dashboard { padding: 16px; }
            .header { flex-direction: column; gap: 16px; text-align: center; }
            .header-left { flex-direction: column; }
            .header-right { flex-wrap: wrap; justify-content: center; }
            .header-content-bottom { flex-direction: column; gap: 20px; }
            .header-filters-box { align-items: center !important; max-width: 100% !important; }
            .header-filters-box .filter-group { justify-content: center !important; width: auto !important; gap: 12px; }
            .vertical-divider { display: none; }
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
            .matrix-grid { grid-template-columns: repeat(2, 1fr); }
